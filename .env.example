# ==============================================================
# CampusCare Environment Variables Template (.env.example)
# Copy this file to .env and adjust values for your environment.
# ==============================================================

# MongoDB Connection String
# For Local MongoDB Community Server:
SPRING_DATA_MONGODB_URI=mongodb://localhost:27017/campuscare
# For MongoDB Atlas (Free Tier cluster):
# SPRING_DATA_MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/campuscare?retryWrites=true&w=majority

# Backend Server Port
PORT=8080

# JWT Security Configuration (Generate a strong 256-bit secret for production)
JWT_SECRET=your_jwt_secret_key_minimum_256_bits_length_here_change_in_production
JWT_EXPIRATION_MS=86400000

# File Upload Directory
FILE_UPLOAD_DIR=uploads

# Automatic Demo Data Seeding (true for initial startup/demo, false for production)
SEED_DEMO_DATA=true
